// 🌙 Project Night - Window Rules Configuration (RON Format)
// Best used for rich, strongly-typed Rust enums and nested structures.
// Stored at: ~/.config/night/rules.ron

[
    // Utilities to automatically float
    Rule(
        app_id: "night-scratchpad",
        action: Float,
    ),
    Rule(
        app_id: "night-scratchpad-term",
        action: Float,
    ),
    Rule(
        app_id: "night-scratchpad-music",
        action: Float,
    ),
    Rule(
        app_id: "night-scratchpad-notes",
        action: Float,
    ),
    Rule(
        app_id: "night-scratchpad-fm",
        action: Float,
    ),
    Rule(
        app_id: "satty",
        action: Float,
    ),
    Rule(
        app_id: "pavucontrol",
        action: Float,
    ),
    Rule(
        app_id: "nm-connection-editor",
        action: Float,
    ),
    Rule(
        app_id: "blueman-manager",
        action: Float,
    ),
    Rule(
        app_id: "rsclip",
        action: Float,
    ),

    // Application tag assignments
    Rule(
        app_id: "zen",
        action: MoveToTag("2"),
    ),
    Rule(
        app_id: "brave",
        action: MoveToTag("2"),
    ),
    Rule(
        app_id: "favnyr",
        action: MoveToTag("3"),
    ),
    Rule(
        app_id: "vivi",
        action: MoveToTag("4"),
    ),
    Rule(
        app_id: "discord",
        action: MoveToTag("8"),
    ),
    Rule(
        app_id: "spotify",
        action: MoveToTag("9"),
    ),
]

