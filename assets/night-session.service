[Unit]
Description=Night Wayland Desktop Session (Pinnacle Compositor)
Documentation=https://github.com/irshadali5/night
BindsTo=graphical-session.target
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/night-session
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=graphical-session.target

