#!/bin/sh
# 🌙 Night Wayland Desktop Environment Launcher
# Sets standard Wayland environment variables and launches Pinnacle.

export XDG_CURRENT_DESKTOP=pinnacle:night
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=night

# Force pure Wayland backends
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland,x11,*
export CLUTTER_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# Execute Pinnacle compositor
exec pinnacle

