# Maintainer: Irshad Ali <irshadali5@github>
# 🌙 Project Night: 100% Rust-Native Wayland Desktop Environment

pkgname=night-desktop-git
_pkgname=night
pkgver=0.1.0.r0
pkgrel=1
pkgdesc="A high-performance, minimalist, 100% Rust-native Wayland desktop environment powered by Pinnacle"
arch=('x86_64' 'aarch64')
url="https://github.com/irshadali5/night"
license=('MIT')

# Core Rust-native desktop suite dependencies
depends=(
    'pinnacle-comp-git'
    'alacritty'
    'ironbar-bin'
    'wired-notify-bin'
    'swayosd-git'
    'swww'
    'wayshot'
    'satty-bin'
    'slurp'
    'wl-screenrec'
    'wayidle'
    'veila-bin'
    'favnyr-git'
    'yazi'
)

optdepends=(
    'rio: GPU-accelerated secondary terminal'
    'anyrun-git: Wayland runner and application launcher'
    'yofi: Ultra-minimalistic application launcher'
    'zen-browser-bin: Performance privacy browser'
    'brave-bin: Web3 chromium browser'
)

makedepends=('cargo' 'git')
provides=('night-desktop' 'nightctl')
conflicts=('night-desktop')
source=("git+https://github.com/irshadali5/night.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    printf "0.1.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen -p night-pinnacle -p nightctl
}

package() {
    cd "$srcdir/$_pkgname"

    # 1. Install Binaries
    install -Dm755 target/release/night-pinnacle "$pkgdir/usr/bin/night-pinnacle"
    install -Dm755 target/release/nightctl "$pkgdir/usr/bin/nightctl"
    install -Dm755 assets/night-session "$pkgdir/usr/bin/night-session"

    # 2. Install Wayland Session Entry
    install -Dm644 assets/night.desktop "$pkgdir/usr/share/wayland-sessions/night.desktop"

    # 3. Install Helper Scripts
    install -d "$pkgdir/usr/share/night/scripts"
    for script in assets/*.sh; do
        install -Dm755 "$script" "$pkgdir/usr/share/night/scripts/$(basename "$script")"
    done

    # 4. Install Default Configuration Templates
    install -d "$pkgdir/usr/share/night/config"
    for cfg in config/*; do
        install -Dm644 "$cfg" "$pkgdir/usr/share/night/config/$(basename "$cfg")"
    done

    # 5. Install Systemd User Units
    install -Dm644 assets/night-session.service "$pkgdir/usr/lib/systemd/user/night-session.service"
    install -Dm644 assets/night-session.target "$pkgdir/usr/lib/systemd/user/night-session.target"

    # 6. Install License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

